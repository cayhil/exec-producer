# Executive Producer — API keys
# Copy to .env and fill in what you have. Cast members whose provider key is
# missing simply don't appear; the engine needs at least TWO available cast
# providers, plus the director's key.
#
# Keep each value alone on its line: dotenv and docker --env-file both read
# an inline "# comment" as part of the value, which makes an empty key look
# set (and fails auth with a very confusing key).

# ── Text models (director, judge, cast) ─────────────────────────────

# starter show: director (gpt-5.4) + Mara
OPENAI_API_KEY=

# starter show: judge (claude-sonnet-4-6) + Jax
ANTHROPIC_API_KEY=

# starter show: Rio · also required for --render-mode veo/vlog (API route)
GEMINI_API_KEY=

# starter show: Sloane
MISTRAL_API_KEY=

# not used by the starter; available for your own shows
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── Optional, per feature flag ──────────────────────────────────────

# --audio/--video TTS voices + vlog speech-to-speech (free tier works)
ELEVENLABS_API_KEY=
