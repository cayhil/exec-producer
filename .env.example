# Executive Producer — API keys
# Copy to .env and fill in what you have. Cast members whose provider key is
# missing simply don't appear; the engine needs at least TWO available cast
# providers, plus the director's key.

# ── Text models (director, judge, cast) ─────────────────────────────
OPENAI_API_KEY=          # starter show: director (gpt-5.4) + Mara
ANTHROPIC_API_KEY=       # starter show: judge (claude-sonnet-4-6) + Jax
GEMINI_API_KEY=          # starter show: Rio · also required for --render-mode veo
MISTRAL_API_KEY=         # starter show: Sloane
XAI_API_KEY=             # not used by the starter; available for your own shows
DEEPSEEK_API_KEY=        # not used by the starter; available for your own shows

# ── Optional, per feature flag ──────────────────────────────────────
ELEVENLABS_API_KEY=      # --audio and --video (persistent TTS voices; free tier works)
